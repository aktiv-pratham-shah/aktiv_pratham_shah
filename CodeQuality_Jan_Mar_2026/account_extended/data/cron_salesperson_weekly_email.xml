<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Email Template -->
        <record id="email_template_salesperson_weekly_due_invoices" model="mail.template">
            <field name="name">Weekly Salesperson Due Invoices Email</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Weekly Report: Unpaid Customer Invoices</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: sans-serif; font-size: 13px;">
                    <p>Dear <t t-out="ctx.get('salesperson_name') or ''"/>,</p>
                    <p>Here is your weekly summary of all unpaid invoices for your customers. Currently, there are <strong><t t-out="ctx.get('invoice_count') or 0"/></strong> unpaid invoice(s).</p>
                    <br/>
                    <t t-out="ctx.get('invoices_table') or ''"/>
                    <br/>
                    <p>Please take necessary actions to follow up with these customers.</p>
                    <p>Best regards,<br/>Odoo System</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Director Email Template -->
        <record id="email_template_directors_weekly_due_invoices" model="mail.template">
            <field name="name">Weekly Directors Due Invoices Summary</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Weekly Master Report: All Unpaid Customer Invoices</field>
            <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: sans-serif; font-size: 13px;">
                    <p>Dear Directors,</p>
                    <p>Here is your weekly master summary of all unpaid invoices across all salespersons. Currently, there are <strong><t t-out="ctx.get('invoice_count') or 0"/></strong> unpaid invoice(s).</p>
                    <br/>
                    <t t-out="ctx.get('invoices_table') or ''"/>
                    <br/>
                    <p>Best regards,<br/>Odoo System</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Cron Job: Weekly Due Invoices to Salesperson -->
        <record id="ir_cron_send_weekly_due_invoices" model="ir.cron">
            <field name="name">Sales: Weekly Due Invoices to Salesperson</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_weekly_due_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
