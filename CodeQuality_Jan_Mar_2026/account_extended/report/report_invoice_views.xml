<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_invoice_document_inherited" inherit_id="account.report_invoice_document">
        <!-- Replace the whole title block -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <t t-if="not proforma">
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                        <t name="invoice_title">Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">
                        <t name="draft_invoice_title">Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">
                        <t name="cancelled_invoice_title">Cancelled Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">
                        <t name="credit_note_title">Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">
                        <t name="draft_credit_note_title">Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">
                        <t name="cancelled_credit_note_title">Cancelled Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'in_refund' and not o.journal_id.is_self_billing">
                        <t name="vendor_credit_note_title">Vendor Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'in_refund' and o.journal_id.is_self_billing">
                        <t name="self_billing_credit_note_title">Self Billing Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'in_invoice' and not o.journal_id.is_self_billing">
                        <t name="vendor_bill_title">Vendor Bill</t>
                    </span>
                    <span t-elif="o.move_type == 'in_invoice' and o.journal_id.is_self_billing">
                        <t name="self_billing_invoice_title">Self Billing</t>
                    </span>
                </t>
                <t t-else="">
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                        <t name="proforma_invoice_title">Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">
                        <t name="draft_proforma_invoice_title">Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">
                        <t name="cancelled_proforma_invoice_title">Invoice</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">
                        <t name="proforma_credit_note_title">Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">
                        <t name="draft_proforma_credit_note_title">Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">
                        <t name="cancelled_proforma_credit_note_title">Cancelled Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'in_refund'">
                        <t name="proforma_vendor_credit_note_title">Vendor Credit Note</t>
                    </span>
                    <span t-elif="o.move_type == 'in_invoice'">
                        <t name="proforma_vendor_bill_title">Vendor Bill</t>
                    </span>
                </t>
                <span t-if="o.name and o.name != '/'" t-field="o.name">INV/2023/0001</span>
            </t>
        </xpath>

        <xpath expr="//div[@class='row'][1]" position="replace">
            <div class="row">
                <t t-set="invoice_contact" t-value="o.partner_id.child_ids.filtered(lambda c: c.type == 'invoice')[:1]"/>
                <!-- SHIPPING ≠ BILLING -->
                <t t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                    <div class="col-6">
                        <t t-set="information_block">
                            <div groups="account.group_delivery_invoice_address" name="shipping_address_block">
                                <strong class="d-block mt-3">Shipping Address</strong>
                                <div t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            </div>
                        </t>
                    </div>
                    <div class="col-6" name="address_not_same_as_shipping">
                        <t t-set="address">
                            <t t-if="invoice_contact">
                                <div><span t-out="invoice_contact[0].name"/></div>
                            </t>
                            <t t-if="o.partner_id">
                                <div><strong t-out="o.partner_id.name"/></div>
                            </t>
                            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            <t t-if="o.partner_id.phone">
                                <div>Phone: <span t-out="o.partner_id.phone"/></div>
                            </t>
                            <t t-if="invoice_contact and invoice_contact[0].email">
                                <div>Email: <span t-out="invoice_contact[0].email"/></div>
                            </t>
                            <t t-elif="o.partner_id.email">
                                <div>Email: <span t-out="o.partner_id.email"/></div>
                            </t>
                            <div t-if="o.partner_id.vat" id="partner_vat_address_not_same_as_shipping">
                                <span>Tax ID</span>: <span t-field="o.partner_id.vat"/>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- SHIPPING == BILLING -->
                <t t-elif="o.partner_shipping_id and (o.partner_shipping_id == o.partner_id)">
                    <div class="offset-col-6 col-6" name="address_same_as_shipping">
                        <t t-set="address">
                            <t t-if="invoice_contact">
                                <div><span t-out="invoice_contact[0].name"/></div>
                            </t>
                            <t t-if="o.partner_id">
                                <div><strong t-out="o.partner_id.name"/></div>
                            </t>
                            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            <t t-if="o.partner_id.phone">
                                <div>Phone: <span t-out="o.partner_id.phone"/></div>
                            </t>
                            <t t-if="invoice_contact and invoice_contact[0].email">
                                <div>Email: <span t-out="invoice_contact[0].email"/></div>
                            </t>
                            <t t-elif="o.partner_id.email">
                                <div>Email: <span t-out="o.partner_id.email"/></div>
                            </t>
                            <div t-if="o.partner_id.vat" id="partner_vat_address_same_as_shipping">
                                <span>Tax ID</span>: <span t-field="o.partner_id.vat"/>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- NO SHIPPING -->
                <t t-else="">
                    <div class="offset-col-6 col-6" name="no_shipping">
                        <t t-set="address">
                            <t t-if="invoice_contact">
                                <div><span t-out="invoice_contact[0].name"/></div>
                            </t>
                            <t t-if="o.partner_id">
                                <div><strong t-out="o.partner_id.name"/></div>
                            </t>
                            <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            <t t-if="o.partner_id.phone">
                                <div>Phone: <span t-out="o.partner_id.phone"/></div>
                            </t>
                            <t t-if="invoice_contact and invoice_contact[0].email">
                                <div>Email: <span t-out="invoice_contact[0].email"/></div>
                            </t>
                            <t t-elif="o.partner_id.email">
                                <div>Email: <span t-out="o.partner_id.email"/></div>
                            </t>
                            <div t-if="o.partner_id.vat" id="partner_vat_no_shipping">
                                <span>Tax ID</span>: <span t-field="o.partner_id.vat"/>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </xpath>

        <xpath expr="//div[@id='informations']" position="before">
            <div class="row mb-4">
                <t t-set="l10n_in_einvoice_json" t-value="o._get_l10n_in_edi_response_json()"/>
                <div t-attf-class="#{'col-0' if report_type != 'html' else 'ms-auto'} row avoid-page-break-inside" t-if="l10n_in_einvoice_json">
                    <div class="col-5 me-2" t-attf-style="#{'' if report_type != 'html' else 'padding: 0 !important;'}">
                        <strong>IRN:</strong>
                        <span t-esc="l10n_in_einvoice_json['Irn']"/>
                    </div>

                    <t t-set="l10n_in_einvoice_json" t-value="o._get_l10n_in_edi_response_json()"/>
                    <div class="col-4" style="padding-left:60px" t-if="l10n_in_einvoice_json" name="ack_no">
                        <strong>Acknowledgement</strong>
                        <div t-out="l10n_in_einvoice_json['AckNo']"/>
                        <div t-out="l10n_in_einvoice_json['AckDt']"/>
                    </div>

                    <div class="col-2 mt-1" style="padding-left:30px">
                        <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %('QR', l10n_in_einvoice_json['SignedQRCode'], 500, 500)" style="max-height: 155px"/>
                    </div>
                </div>
                <div class="oe_structure"/>
            </div>
        </xpath>

        <!-- Remove the "Taxes" header column -->
        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_taxes']" position="replace"/>

        <!-- Remove the "Taxes" data cell for each line -->
        <xpath expr="//table[@name='invoice_line_table']//td[@name='td_taxes']" position="replace"/>

        <xpath expr="//div[@id='right-elements']" position="attributes">
            <attribute name="t-attf-class">#{'col-5' if report_type == 'pdf' else 'col-12 col-md-5'} ms-5 d-inline-block float-end</attribute>
        </xpath>

        <xpath expr="//t[@t-if=&quot;o.tax_totals and o.tax_totals.get('display_in_company_currency')&quot;]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>




    <template id="l10n_in_report_invoice_document_report_title" inherit_id="l10n_in.l10n_in_report_invoice_document_inherit" priority="300">
        <xpath expr="//t[@name='invoice_title']" position="replace">
            <t name="invoice_title">Invoice</t>
        </xpath>
        <xpath expr="//div[@name='l10n_in_hsn_summary']" position="replace"/>
    </template>


    <template id="place_of_supply_override" inherit_id="l10n_in.place_of_supply">
        <xpath expr="//div[@t-if='o.company_id.l10n_in_is_gst_registered and o.l10n_in_state_id']" position="replace">
            <div t-if="o.l10n_in_state_id and o.partner_id.country_id">
                Place of supply: <span t-out="o.partner_id.country_id.name"/>
            </div>
        </xpath>
    </template>


    <template id="remove_acknowledgement_block" inherit_id="l10n_in_edi.l10n_in_einvoice_report_invoice_document_inherit">
        <!-- Remove the Acknowledgement block -->
        <xpath expr="//div[@name='ack_no']" position="replace"/>

    </template>

</odoo>
