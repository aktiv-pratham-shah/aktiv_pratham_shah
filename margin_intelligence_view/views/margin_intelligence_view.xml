<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Inherit: Show Commission -->
    <record id="view_order_form_inherit_margin" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.margin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="projected_commission" widget="monetary" decoration-bf="1" decoration-success="projected_commission &gt; 0"/>
            </xpath>
        </field>
    </record>

    <!-- Res Users Inherit: Commission Rate -->
    <record id="view_users_form_inherit_margin" model="ir.ui.view">
        <field name="name">res.users.form.inherit.margin</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="Margin &amp; Commissions" name="margin_commissions">
                    <group>
                        <field name="commission_rate" widget="percentage"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Res Config Settings: Margin Threshold -->
    <record id="res_config_settings_view_form_margin" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.margin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="margin_protection_guard" title="Protect your profitability by setting a minimum margin threshold." string="Margin Protection Guard" help="Block sale orders with low margins.">
                    <div class="content-group">
                        <div class="mt16">
                            <label for="margin_threshold" class="o_light_label"/>
                            <field name="margin_threshold" class="oe_inline"/> %
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <!-- Client Action for Margin Intelligence Dashboard -->
    <record id="action_margin_intelligence" model="ir.actions.client">
        <field name="name">Margin Intelligence</field>
        <field name="tag">margin_intelligence_view.dashboard</field>
        <field name="target">main</field>
    </record>

    <!-- Sales Menu Item -->
    <menuitem id="menu_sale_margin_intelligence"
              name="Margin Intelligence"
              parent="sale.menu_sale_report"
              action="action_margin_intelligence"
              sequence="20"/>

    <!-- Purchase Menu Item -->
    <menuitem id="menu_purchase_margin_intelligence"
              name="Margin Intelligence"
              parent="purchase.purchase_report_main"
              action="action_margin_intelligence"
              sequence="20"/>
</odoo>
