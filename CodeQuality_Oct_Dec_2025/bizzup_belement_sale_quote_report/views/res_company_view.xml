<odoo>
    <record id="view_company_form_inherit_custom_logo" model="ir.ui.view">
        <field name="name">res.company.form.inherit.custom.logo</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <!-- Add after existing company logo -->
            <xpath expr="//field[@name='color']" position="after">
                    <field name="header_logo" widget="image"/>
                    <field name="header_logo_2" widget="image"/>
            </xpath>
        </field>
    </record>
</odoo>
