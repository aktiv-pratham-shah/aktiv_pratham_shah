<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <!-- ===========================================================
         PCN Report: Custom report to compute VAT sales, VAT inputs, VAT exempt sales, and VAT due
         =========================================================== -->
    <record id="pcn_report" model="account.report">
        <field name="name">PCN Report</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="filter_fiscal_position" eval="True"/>
        <field name="availability_condition">always</field>

        <!-- ===================== Columns ===================== -->
        <field name="column_ids">
            <record id="pcn_report_balance_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>

        <!-- ===================== Lines ===================== -->
        <field name="line_ids">

            <!-- ========== ROOT: VAT SALES (BASE) ========== -->
            <record id="report_vat_sales_base" model="account.report.line">
                <field name="name">VAT SALES (BASE)</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="report_vat_sales_base_exp" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">ILTAX_OUT_BASE_COPY.balance</field>
                    </record>
                </field>
                <field name="children_ids">

                    <!-- VAT SALES (BASE) CHILD -->
                    <record id="report_vat_sales_base_child" model="account.report.line">
                        <field name="name">VAT SALES (BASE)</field>
                        <field name="code">ILTAX_OUT_BASE_COPY</field>
                        <field name="hierarchy_level">3</field>
                        <field name="expression_ids">
                            <record id="report_vat_sales_base_child_exp" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula">[('tax_tag_ids', 'in', [10,9]), ('move_id.is_pcn', '=',
                                    False)]
                                </field>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>

                </field>
            </record>

            <!-- ========== ROOT: VAT SALES (TAX) ========== -->
            <record id="report_vat_sales_tax" model="account.report.line">
                <field name="name">VAT SALES (TAX)</field>
                <field name="code">ILTAX_OUT_BALANCE_COPYY</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="report_vat_sales_tax_exp" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">ILTAX_OUT_BALANCE_00_COPY.balance +
                            ILTAX_OUT_BALANCE_PA_COPY.balance
                        </field>
                    </record>
                </field>
                <field name="children_ids">

                    <!-- VAT SALES CHILD -->
                    <record id="report_vat_sales_child" model="account.report.line">
                        <field name="name">VAT SALES</field>
                        <field name="code">ILTAX_OUT_BALANCE_00_COPY</field>
                        <field name="hierarchy_level">3</field>
                        <field name="expression_ids">
                            <record id="report_vat_sales_child_exp" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula">[('tax_tag_ids', 'in', [11,12]), ('move_id.is_pcn', '=',
                                    False)]
                                </field>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>

                    <!-- VAT PA SALES CHILD -->
                    <record id="report_vat_pa_sales_child" model="account.report.line">
                        <field name="name">VAT PA Sales</field>
                        <field name="code">ILTAX_OUT_BALANCE_PA_COPY</field>
                        <field name="hierarchy_level">3</field>
                        <field name="expression_ids">
                            <record id="report_vat_pa_sales_child_exp" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula">[('tax_tag_ids', 'in', [13,14]), ('move_id.is_pcn', '=',
                                    False)]
                                </field>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>

            <!-- ========== ROOT: VAT Exempt Sales (BASE) ========== -->
            <record id="report_vat_exempt_sales_base" model="account.report.line">
                <field name="name">VAT Exempt Sales (BASE)</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="report_vat_exempt_sales_base_exp" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">ILTAX_OUT_BASE_exempt_COPY.balance</field>
                    </record>
                </field>
                <field name="children_ids">

                    <!-- VAT Exempt Sales (BASE) CHILD -->
                    <record id="report_vat_exempt_sales_base_child" model="account.report.line">
                        <field name="name">VAT Exempt SALES (BASE)</field>
                        <field name="code">ILTAX_OUT_BASE_exempt_COPY</field>
                        <field name="hierarchy_level">3</field>
                        <field name="expression_ids">
                            <record id="report_vat_exempt_sales_base_child_exp" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula">[('tax_tag_ids', 'in', [15,16]), ('move_id.is_pcn', '=', False)]
                                </field>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>

            <!-- ========== ROOT: VAT INPUTS (TAX) ========== -->
            <record id="report_vat_inputs_tax" model="account.report.line">
                <field name="name">VAT INPUTS (TAX)</field>
                <field name="code">ILTAX_IN_BALANCE_COPY</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="report_vat_inputs_tax_exp" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">
                            ILTAX_IN_BALANCE_17_COPY.balance+ILTAX_IN_BALANCE_18_COPY.balance+ILTAX_IN_BALANCE_2_3_COPY.balance+ILTAX_IN_BALANCE_1_4_COPY.balance+ILTAX_IN_BALANCE_PA_COPY.balance
                        </field>
                    </record>
                </field>
                <field name="children_ids">

                    <!-- VAT Inputs 17% CHILD -->
                    <record id="report_vat_inputs_17%_child" model="account.report.line">
                        <field name="name">VAT Inputs 17%</field>
                        <field name="code">ILTAX_IN_BALANCE_18_COPY</field>
                        <field name="hierarchy_level">3</field>
                        <field name="expression_ids">
                            <record id="report_vat_inputs_17%_child_exp" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula">[('tax_tag_ids', 'in', [17,18]), ('move_id.is_pcn', '=', False)]
                                </field>
                                <field name="subformula">sum</field>
                            </record>
                        </field>
                    </record>

                    <!-- VAT Inputs 18% CHILD -->
                    <record id="report_vat_inputs_18%_child" model="account.report.line">
                        <field name="name">VAT Inputs 18%</field>
                        <field name="code">ILTAX_IN_BALANCE_17_COPY</field>
                        <field name="hierarchy_level">3</field>
                        <field name="expression_ids">
                            <record id="report_vat_inputs_18%_child_exp" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula">[('tax_tag_ids', 'in', [59,61]), ('move_id.is_pcn', '=', False)]
                                </field>
                                <field name="subformula">sum</field>
                            </record>
                        </field>
                    </record>

                    <!-- VAT Inputs PA 16% CHILD -->
                    <record id="report_vat_inputs_pa_16%_child" model="account.report.line">
                        <field name="name">VAT Inputs PA 16%</field>
                        <field name="code">ILTAX_IN_BALANCE_PA_COPY</field>
                        <field name="hierarchy_level">3</field>
                        <field name="expression_ids">
                            <record id="report_vat_inputs_pa_16%_child_exp" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula">[('tax_tag_ids', 'in', [19,20]), ('move_id.is_pcn', '=', False)]
                                </field>
                                <field name="subformula">sum</field>
                            </record>
                        </field>
                    </record>

                    <!-- VAT Inputs 2/3 CHILD -->
                    <record id="report_vat_inputs_2_3_child" model="account.report.line">
                        <field name="name">VAT Inputs 2/3</field>
                        <field name="code">ILTAX_IN_BALANCE_2_3_COPY</field>
                        <field name="hierarchy_level">3</field>
                        <field name="expression_ids">
                            <record id="report_vat_inputs_2_3_child_exp" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula">[('tax_tag_ids', 'in', [21,22]), ('move_id.is_pcn', '=', False)]
                                </field>
                                <field name="subformula">sum</field>
                            </record>
                        </field>
                    </record>

                    <!-- VAT Inputs 1/4 CHILD -->
                    <record id="report_vat_inputs_1_4_child" model="account.report.line">
                        <field name="name">VAT Inputs 1/4</field>
                        <field name="code">ILTAX_IN_BALANCE_1_4_COPY</field>
                        <field name="hierarchy_level">3</field>
                        <field name="expression_ids">
                            <record id="report_vat_inputs_1_4_child_exp" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula">[('tax_tag_ids', 'in', [23,24]), ('move_id.is_pcn', '=', False)]
                                </field>
                                <field name="subformula">sum</field>
                            </record>
                        </field>
                    </record>

                </field>
            </record>

            <!-- ========== ROOT: VAT INPUTS (fixed assets) ========== -->
            <record id="report_vat_inputs_fixed_assets" model="account.report.line">
                <field name="name">VAT INPUTS (fixed assets)</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="report_vat_inputs_fixed_assets_exp" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">ILTAX_VAT_IN_FA_COPY.balance</field>
                    </record>
                </field>
                <field name="children_ids">

                    <!-- VAT INPUTS (fixed assets) CHILD -->
                    <record id="report_vat_inputs_fixed_assets_child" model="account.report.line">
                        <field name="name">VAT INPUTS (fixed assets)</field>
                        <field name="code">ILTAX_VAT_IN_FA_COPY</field>
                        <field name="hierarchy_level">3</field>
                        <field name="expression_ids">
                            <record id="report_vat_inputs_fixed_assets_child_exp" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula">[('tax_tag_ids', 'in', [25,26]), ('move_id.is_pcn', '=', False)]
                                </field>
                                <field name="subformula">sum</field>
                            </record>
                        </field>
                    </record>

                </field>
            </record>

            <!-- ========== ROOT: VAT DUE ========== -->
            <record id="report_vat_due" model="account.report.line">
                <field name="name">VAT DUE</field>
                <field name="code">ILTAX_VAT_DUE_COPY</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="report_vat_due_exp" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">(ILTAX_OUT_BALANCE_00_COPY.balance + ILTAX_OUT_BALANCE_PA_COPY.balance) -
                            (ILTAX_IN_BALANCE_17_COPY.balance + ILTAX_IN_BALANCE_18_COPY.balance +
                            ILTAX_IN_BALANCE_2_3_COPY.balance + ILTAX_IN_BALANCE_1_4_COPY.balance +
                            ILTAX_IN_BALANCE_PA_COPY.balance) - ILTAX_VAT_IN_FA_COPY.balance
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
